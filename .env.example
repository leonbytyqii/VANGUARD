# ---------------------------------------------------------------------------
# SOC-AI environment configuration
#
# Copy this file to .env in the repo root before running `docker compose up`.
# Never commit a real .env file. Every secret below has no working default
# in production — the app fails closed rather than falling back to something
# insecure.
# ---------------------------------------------------------------------------

# --- Core ---
ENVIRONMENT=development
DEBUG=true

# --- Database (used by both `backend` and `docker-compose.yml`) ---
POSTGRES_USER=socai
POSTGRES_PASSWORD=change_me_in_any_shared_environment
POSTGRES_DB=socai
DATABASE_URL=postgresql+psycopg2://socai:change_me_in_any_shared_environment@postgres:5432/socai

# --- Redis (background jobs: detection execution, agent investigations) ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- Account lockout / brute-force protection ---
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# --- Password policy ---
PASSWORD_MIN_LENGTH=12

# --- Bootstrap admin (app/db/seed.py; only used when the users table is
# empty). Leave ADMIN_BOOTSTRAP_PASSWORD unset to have a random one
# generated and printed once to the startup log instead. ---
ADMIN_BOOTSTRAP_EMAIL=admin@soc-ai.local
ADMIN_BOOTSTRAP_PASSWORD=

# --- CORS (comma-separated origins allowed to call the API) ---
CORS_ORIGINS=http://localhost:3000

# --- Rate limiting (slowapi, per source IP) ---
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute

# --- AI provider abstraction ---
# AI_PROVIDER=mock uses a deterministic local analyst — no key required,
# fully demonstrable offline. Switch to openai_compatible to use a real
# OpenAI-compatible endpoint (OpenAI, Azure OpenAI, a local vLLM server, ...).
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=
AI_MAX_TOOL_ITERATIONS=12
AI_REQUEST_TIMEOUT_SECONDS=60

# --- Threat intelligence providers ---
# THREAT_INTEL_MODE=mock returns deterministic synthetic enrichment so the
# platform works with zero external accounts. Set to `live` once keys below
# are populated.
THREAT_INTEL_MODE=mock
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=

# --- Frontend ---
NEXT_PUBLIC_APP_NAME=SOC-AI
BACKEND_INTERNAL_URL=http://backend:8000
